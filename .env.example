# Local-only Compose setup. Choose a strong password before the first start.
BOOTSTRAP_ADMIN_USERNAME=administrator
BOOTSTRAP_ADMIN_PASSWORD=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Optional exact upstream POST endpoint: {question} -> {answer, sources}.
# Set AI_MODE=mock for labelled local mock answers; accounts and claims remain real.
AI_MODE=http
AI_URL=
AI_API_KEY=
AI_TIMEOUT=420
# To enable integrated ML: AI_MODE=http, AI_URL=http://ml:8001/ask,
# and docker compose --profile ml up -d --build. Index manuals first (ml_service/README.md).
VLLM_BASE_URL=http://llm:8002/v1
VLLM_API_KEY=EMPTY
MODEL_NAME=local-qwen

# Password-free test account switching INCLUDING ADMIN. Local-only; never enable publicly.
DEMO_ACCOUNTS=false

# Required for all user messages, including mock-AI demos. No silent allow fallback.
MODERATION_URL=http://moderation:8003/check
MODERATION_API_KEY=
MODERATION_TIMEOUT=2
MODERATION_MODEL_PATH=./.demo/models/moderation
OBSCENITY_THRESHOLD=0.95
