# Postgres connection (same database the "raw claims/messages/reactions"
# tables and Metabase both read from).
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tender-hack

# Comma-separated list of origins allowed to call this API from a browser.
# Defaults to the Vite dev server if unset. Use explicit origins in
# production — avoid "*" unless you specifically intend a public API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Metabase integration (all optional — dashboards can still be created
# without these, but widgets won't render until they're set).
# METABASE_URL is the only one that is also safe to expose to the frontend
# (as VITE_METABASE_URL); the three below must NEVER be given to the
# frontend or committed to source control.
METABASE_URL=http://localhost:3000
# Settings -> Admin -> API Keys in Metabase.
METABASE_API_KEY=
# Settings -> Admin -> Embedding -> enable "Static embedding", then copy the
# secret it generates. Required only for signed embed URLs.
METABASE_EMBEDDING_SECRET=
# The numeric id Metabase assigned to the Postgres connection above when it
# was added via the Metabase admin UI (Admin -> Databases). There is no way
# to discover this from the analytics backend itself.
METABASE_DATABASE_ID=
