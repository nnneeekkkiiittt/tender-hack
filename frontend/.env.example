# demo | api
VITE_APP_MODE=api

# Main backend (tickets, auth, employees). Used only when VITE_APP_MODE=api.
VITE_API_URL=/api

# Analytics Go microservice — a SEPARATE service/origin from the main
# backend above (its own Postgres connection). Base URL only, no path;
# each call appends /api/v1/... itself. See src/api/analyticsClient.ts.
VITE_ANALYTICS_API_URL=http://localhost:8080

# Metabase base URL, used to build embedded dashboard iframes in API mode.
# Only a URL — no API key or embedding secret ever belongs here; those stay
# backend-side (see analytics/internal/metabase and analytics/.env.example).
VITE_METABASE_URL=http://localhost:3000
